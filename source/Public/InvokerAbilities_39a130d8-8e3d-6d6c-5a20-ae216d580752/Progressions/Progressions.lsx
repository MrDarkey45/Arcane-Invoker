<?xml version="1.0" encoding="UTF-8"?>
<save>
    <version major="4" minor="0" revision="9" build="330"/>
    <region id="Progressions">
        <node id="root">
            <children>
                <!-- Adds Arcane Invoker to the Wizard subclass choice at level 2 (proper). -->
                <node id="Progression">
                    <attribute id="Name" type="LSString" value="Wizard"/>
                    <attribute id="TableUUID" type="guid" value="d18eda7e-4b7d-490d-9952-cd33a3c60479"/>
                    <attribute id="UUID" type="guid" value="782b9a20-c2d8-4a61-8f7a-bc8f2f97a2f4"/>
                    <attribute id="Level" type="uint8" value="2"/>
                    <attribute id="ProgressionType" type="uint8" value="0"/>
                    <children>
                        <node id="SubClasses">
                            <children>
                                <node id="SubClass">
                                    <attribute id="Object" type="guid" value="7b281658-5329-4a63-aa56-6faec8f383c8"/>
                                </node>
                            </children>
                        </node>
                    </children>
                </node>
                <!-- Arcane Invoker features, granted when the subclass is chosen (Wizard level 2):
                     the orb + Invoke spell list, +1 action per turn, and the Arcane Strike attack. -->
                <node id="Progression">
                    <attribute id="Name" type="LSString" value="ArcaneInvoker"/>
                    <attribute id="TableUUID" type="guid" value="aa1678e1-d925-4a89-bba6-32bceb1b75e5"/>
                    <attribute id="UUID" type="guid" value="125647cd-4875-4806-b0a6-b6b03b17dcdf"/>
                    <attribute id="Level" type="uint8" value="2"/>
                    <attribute id="ProgressionType" type="uint8" value="1"/>
                    <attribute id="Boosts" type="LSString" value="ActionResource(ActionPoint,1,0);UnlockSpell(INVOKER_ARCANE_STRIKE);ActionResource(SpellSlot,1,3);ActionResource(SpellSlot,2,2)"/>
                    <attribute id="Selectors" type="LSString" value="AddSpells(793881ae-b38c-4d7d-a9f1-672a070f648e,,,,AlwaysPrepared)"/>
                </node>
            </children>
        </node>
    </region>
</save>
